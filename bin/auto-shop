#!/usr/bin/env node

/**
 * auto-shop CLI
 *
 * Convenience tool for common coordinator workflows
 *
 * Usage:
 *   auto-shop cell create <name>      Create a new feature cell
 *   auto-shop cell list               List all cells across all projects
 *   auto-shop cell teardown <name>    Clean up a feature cell
 *   auto-shop project list            List all registered projects
 *   auto-shop project show <name>    Show full details for a project
 *   auto-shop queue show              Show merge queue
 *   auto-shop queue next              Merge next cell
 *   auto-shop infra setup <project>   Set up Claude Code hooks via project registry
 *   auto-shop prompt <issue-ref>     Generate agent prompt for a GitHub issue
 *   auto-shop launch <issue-ref>    Generate prompt and launch remote session
 *   auto-shop help                    Show help
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const REPO_ROOT = path.dirname(path.dirname(__filename));
const MERGE_QUEUE_PATH = path.join(REPO_ROOT, 'MERGE_QUEUE.md');
const PROJECTS_PATH = path.join(REPO_ROOT, 'projects.json');

function log(message, color = 'reset') {
  const colors = {
    reset: '\x1b[0m',
    green: '\x1b[32m',
    red: '\x1b[31m',
    yellow: '\x1b[33m',
    blue: '\x1b[34m',
  };
  console.log(`${colors[color]}${message}${colors.reset}`);
}

function error(message) {
  log(`✗ ${message}`, 'red');
  process.exit(1);
}

function success(message) {
  log(`✓ ${message}`, 'green');
}

function warn(message) {
  log(`⚠ ${message}`, 'yellow');
}

function info(message) {
  log(`ℹ ${message}`, 'blue');
}

function loadProjects() {
  if (!fs.existsSync(PROJECTS_PATH)) {
    error(`projects.json not found at ${PROJECTS_PATH}`);
  }
  const data = JSON.parse(fs.readFileSync(PROJECTS_PATH, 'utf8'));
  return data.projects;
}

function resolveProject(name) {
  const projects = loadProjects();
  if (!projects[name]) {
    error(`Unknown project: ${name}\nRegistered projects: ${Object.keys(projects).join(', ')}`);
  }
  return projects[name];
}

function parseFlags(argv) {
  const flags = {};
  for (const arg of argv) {
    const match = arg.match(/^--(\w[\w-]*)=(.+)$/);
    if (match) {
      flags[match[1]] = match[2];
    }
  }
  return flags;
}

function projectList() {
  const projects = loadProjects();

  log('\nRegistered Projects:\n', 'blue');
  for (const [name, proj] of Object.entries(projects)) {
    log(`  ${name}`, 'green');
    log(`    repo:           ${proj.repo}`);
    log(`    localPath:      ${proj.localPath}`);
    log(`    defaultBranch:  ${proj.defaultBranch}`);
    log(`    featureTarget:  ${proj.featureTarget}`);
    log(`    promotionPath:  ${proj.promotionPath.join(' -> ')}`);
    log(`    scopeTemplate:  ${proj.scopeTemplate || '(none)'}`);
    if (proj.packages) {
      log(`    packages:       ${Object.keys(proj.packages).length} (use 'project show ${name}' for details)`);
    }
    log('');
  }
}

function projectShow(name) {
  if (!name) {
    error('Usage: auto-shop project show <project-name>');
  }

  const proj = resolveProject(name);

  log(`\n${name}\n`, 'blue');
  log(`  repo:           ${proj.repo}`);
  log(`  localPath:      ${proj.localPath}`);
  log(`  defaultBranch:  ${proj.defaultBranch}`);
  log(`  featureTarget:  ${proj.featureTarget}`);
  log(`  promotionPath:  ${proj.promotionPath.join(' -> ')}`);
  log(`  scopeTemplate:  ${proj.scopeTemplate || '(none)'}`);

  if (!proj.packages) {
    log('\n  (single-repo project)\n');
    return;
  }

  log(`\n  Packages (${Object.keys(proj.packages).length}):\n`, 'blue');

  for (const [pkgName, pkg] of Object.entries(proj.packages)) {
    log(`    ${pkgName}`, 'green');
    log(`      repo:           ${pkg.repo}`);
    log(`      path:           ${pkg.path}`);
    if (pkg.featureTarget) {
      log(`      featureTarget:  ${pkg.featureTarget} (override)`);
    }
    if (pkg.scopeOverrides) {
      log(`      scopeOverrides: yes`);
    }
    log('');
  }
}

function cellCreateSingleRepo(featureName, proj, projectName) {
  const cwd = proj ? proj.localPath : process.cwd();
  const featureTarget = proj ? proj.featureTarget : 'main';
  const scopeTemplatePath = proj && proj.scopeTemplate
    ? path.join(REPO_ROOT, proj.scopeTemplate)
    : null;

  if (!fs.existsSync(path.join(cwd, '.git'))) {
    error(`${cwd} is not a git repository. Use --project=<name> or run from the target project root.`);
  }

  const featureSlug = featureName.toLowerCase().replace(/[^a-z0-9]/g, '-');
  const branchName = `feat/${featureSlug}`;
  const schemaName = `feat_${featureSlug.replace(/-/g, '_')}`;

  try {
    info(`Checking out ${featureTarget}`);
    execSync(`git checkout ${featureTarget}`, { cwd, stdio: 'inherit' });
    execSync(`git pull origin ${featureTarget}`, { cwd, stdio: 'inherit' });

    info(`Creating branch: ${branchName}`);
    execSync(`git checkout -b ${branchName}`, { cwd, stdio: 'inherit' });

    info('Creating SCOPE.json');
    const templateToUse = scopeTemplatePath || path.join(REPO_ROOT, 'templates', 'SCOPE.json');
    const scope = JSON.parse(fs.readFileSync(templateToUse, 'utf8'));
    scope.feature = featureName;
    scope.branch = branchName;
    scope.createdAt = new Date().toISOString().slice(0, 10);
    if (projectName) {
      scope.project = projectName;
    }

    const scopePath = path.join(cwd, 'SCOPE.json');
    fs.writeFileSync(scopePath, JSON.stringify(scope, null, 2) + '\n');

    execSync(`git add SCOPE.json && git commit -m "Add SCOPE.json for ${branchName}"`, {
      cwd,
      stdio: 'inherit'
    });

    const provisionScript = path.join(REPO_ROOT, 'scripts', 'provision-feature-env.sh');
    info(`Provisioning database schema: ${schemaName}`);
    execSync(`"${provisionScript}" ${featureSlug}`, {
      cwd,
      stdio: 'inherit'
    });

    success(`Cell created: ${branchName}`);
    info(`Next: Create GitHub issue with feature-cell template`);
    info(`      Launch agent session with: cat templates/agent-prompt.template.md`);

  } catch (err) {
    error(`Failed to create cell: ${err.message}`);
  }
}

function cellCreateMultiRepo(featureName, proj, projectName, selectedPackages) {
  const featureSlug = featureName.toLowerCase().replace(/[^a-z0-9]/g, '-');
  const branchName = `feat/${featureSlug}`;
  const featureGroup = featureSlug;

  const allPackages = Object.keys(proj.packages);
  const packagesToCreate = selectedPackages || allPackages;

  // Validate selected packages
  for (const pkg of packagesToCreate) {
    if (!proj.packages[pkg]) {
      error(`Unknown package: ${pkg}\nAvailable packages: ${allPackages.join(', ')}`);
    }
  }

  const scopeTemplatePath = proj.scopeTemplate
    ? path.join(REPO_ROOT, proj.scopeTemplate)
    : path.join(REPO_ROOT, 'templates', 'SCOPE.json');

  info(`Creating multi-repo cell: ${branchName}`);
  info(`Packages: ${packagesToCreate.join(', ')}`);
  log('');

  const created = [];

  for (const pkgName of packagesToCreate) {
    const pkg = proj.packages[pkgName];
    const pkgPath = path.join(proj.localPath, pkg.path);

    if (!fs.existsSync(pkgPath)) {
      warn(`Skipping ${pkgName}: path does not exist (${pkgPath})`);
      continue;
    }

    if (!fs.existsSync(path.join(pkgPath, '.git'))) {
      warn(`Skipping ${pkgName}: not a git repository (${pkgPath})`);
      continue;
    }

    const target = pkg.featureTarget || proj.featureTarget;

    try {
      log(`\n--- ${pkgName} (${pkg.repo}) ---`, 'blue');

      info(`Checking out ${target}`);
      execSync(`git checkout ${target}`, { cwd: pkgPath, stdio: 'inherit' });
      execSync(`git pull origin ${target}`, { cwd: pkgPath, stdio: 'inherit' });

      info(`Creating branch: ${branchName}`);
      execSync(`git checkout -b ${branchName}`, { cwd: pkgPath, stdio: 'inherit' });

      info('Creating SCOPE.json');
      const scope = JSON.parse(fs.readFileSync(scopeTemplatePath, 'utf8'));
      scope.feature = featureName;
      scope.project = projectName;
      scope.branch = branchName;
      scope.createdAt = new Date().toISOString().slice(0, 10);
      scope.package = pkgName;
      scope.featureGroup = featureGroup;

      if (pkg.scopeOverrides) {
        if (pkg.scopeOverrides.allowedPaths) {
          scope.allowedPaths = pkg.scopeOverrides.allowedPaths;
        }
        if (pkg.scopeOverrides.forbiddenPaths) {
          scope.forbiddenPaths = pkg.scopeOverrides.forbiddenPaths;
        }
      }

      const scopePath = path.join(pkgPath, 'SCOPE.json');
      fs.writeFileSync(scopePath, JSON.stringify(scope, null, 2) + '\n');

      execSync(`git add SCOPE.json && git commit -m "Add SCOPE.json for ${branchName}"`, {
        cwd: pkgPath,
        stdio: 'inherit'
      });

      created.push(pkgName);
      success(`${pkgName}: branch and SCOPE.json created`);

    } catch (err) {
      warn(`Failed to create cell in ${pkgName}: ${err.message}`);
    }
  }

  log('');
  if (created.length > 0) {
    success(`Cell created in ${created.length}/${packagesToCreate.length} packages: ${created.join(', ')}`);
    info(`Feature group: ${featureGroup}`);
    info(`Next: Create GitHub issue with feature-cell template`);
  } else {
    error('No packages were successfully set up');
  }
}

function cellCreate(featureName) {
  if (!featureName) {
    error('Usage: auto-shop cell create <feature-name> [--project=<name>] [--packages=<p1,p2,...>]');
  }

  const flags = parseFlags(process.argv);

  if (flags.project) {
    const proj = resolveProject(flags.project);

    if (!fs.existsSync(proj.localPath)) {
      error(`Project local path does not exist: ${proj.localPath}`);
    }

    if (proj.packages) {
      const selectedPackages = flags.packages
        ? flags.packages.split(',').map(p => p.trim())
        : null;
      cellCreateMultiRepo(featureName, proj, flags.project, selectedPackages);
    } else {
      cellCreateSingleRepo(featureName, proj, flags.project);
    }
  } else {
    cellCreateSingleRepo(featureName, null, null);
  }
}

function cellList() {
  const projects = loadProjects();

  // Build list of repos to query, including package repos
  const repoEntries = [];
  for (const [name, proj] of Object.entries(projects)) {
    repoEntries.push({ project: name, repo: proj.repo, package: null });
    if (proj.packages) {
      for (const [pkgName, pkg] of Object.entries(proj.packages)) {
        // Avoid duplicating the parent repo
        if (pkg.repo !== proj.repo) {
          repoEntries.push({ project: name, repo: pkg.repo, package: pkgName });
        }
      }
    }
  }

  try {
    let currentProject = null;

    for (const entry of repoEntries) {
      if (entry.project !== currentProject) {
        currentProject = entry.project;
        log(`\n${entry.project}:`, 'blue');
      }

      const label = entry.package ? `  ${entry.package} (${entry.repo})` : `  ${entry.repo}`;
      let hasIssues = false;

      for (const cellLabel of ['cell:active', 'cell:queued', 'cell:blocked', 'cell:awaiting-review']) {
        let output;
        try {
          output = execSync(`gh issue list --repo ${entry.repo} --label "${cellLabel}" --json number,title`, {
            encoding: 'utf8',
            stdio: ['pipe', 'pipe', 'pipe']
          });
        } catch {
          continue;
        }

        const issues = JSON.parse(output);
        if (issues.length > 0) {
          if (!hasIssues) {
            log(label, 'green');
            hasIssues = true;
          }
          log(`    ${cellLabel}:`, 'yellow');
          issues.forEach(issue => {
            log(`      #${issue.number}: ${issue.title}`);
          });
        }
      }
    }
    log('');

  } catch (err) {
    error(`Failed to list cells: ${err.message}`);
  }
}

function cellTeardown(featureName) {
  if (!featureName) {
    error('Usage: auto-shop cell teardown <feature-name>');
  }

  const featureSlug = featureName.toLowerCase().replace(/[^a-z0-9]/g, '-');

  try {
    info(`Tearing down: ${featureSlug}`);
    execSync(`./scripts/teardown-feature-env.sh ${featureSlug}`, {
      cwd: REPO_ROOT,
      stdio: 'inherit'
    });
    success(`Cell teardown complete: ${featureSlug}`);
  } catch (err) {
    error(`Teardown failed: ${err.message}`);
  }
}

function queueShow() {
  try {
    if (!fs.existsSync(MERGE_QUEUE_PATH)) {
      warn('MERGE_QUEUE.md not found');
      info('Run: cp templates/MERGE_QUEUE.md MERGE_QUEUE.md');
      return;
    }

    const queueContent = fs.readFileSync(MERGE_QUEUE_PATH, 'utf8');
    log(queueContent);

  } catch (err) {
    error(`Failed to show queue: ${err.message}`);
  }
}

function infraSetup(firstArg, secondArg) {
  // Two modes:
  //   auto-shop infra setup <project-name>          (registry lookup)
  //   auto-shop infra setup <repo-path> <project-name>  (legacy two-arg)
  let repoPath;
  let projectName;

  if (firstArg && !secondArg) {
    // Single arg: treat as project name from registry
    const proj = resolveProject(firstArg);
    repoPath = proj.localPath;
    projectName = firstArg;
  } else if (firstArg && secondArg) {
    // Two args: legacy path + name
    repoPath = firstArg;
    projectName = secondArg;
  } else {
    error('Usage: auto-shop infra setup <project-name>\n       auto-shop infra setup <repo-path> <project-name>');
  }

  // Write .claude/project.json with identity metadata
  const proj = resolveProject(projectName);
  const claudeDir = path.join(repoPath, '.claude');
  if (!fs.existsSync(claudeDir)) {
    fs.mkdirSync(claudeDir, { recursive: true });
  }

  const projectMeta = {
    project: projectName,
    repo: proj.repo,
    defaultBranch: proj.defaultBranch,
    featureTarget: proj.featureTarget,
  };

  // For package repos, find the package entry whose localPath matches repoPath
  if (proj.packages) {
    for (const [pkgName, pkg] of Object.entries(proj.packages)) {
      const pkgPath = path.join(proj.localPath, pkg.path);
      if (repoPath === pkgPath || repoPath === path.resolve(pkgPath)) {
        projectMeta.package = pkgName;
        projectMeta.repo = pkg.repo;
        if (pkg.featureTarget) {
          projectMeta.featureTarget = pkg.featureTarget;
        }
        break;
      }
    }
  }

  const projectJsonPath = path.join(claudeDir, 'project.json');
  fs.writeFileSync(projectJsonPath, JSON.stringify(projectMeta, null, 2) + '\n');
  info(`Wrote .claude/project.json (repo: ${projectMeta.repo})`);

  const setupScript = path.join(REPO_ROOT, 'scripts', 'setup-claude-infra.sh');
  try {
    execSync(`bash "${setupScript}" "${repoPath}" "${projectName}" "${projectMeta.repo}" "${projectMeta.featureTarget}"`, {
      stdio: 'inherit'
    });
  } catch (err) {
    error(`Infrastructure setup failed: ${err.message}`);
  }
}

function queueNext() {
  warn('auto-shop queue next is not yet implemented');
  info('For now, use docs/merge-procedure.md as a guide');
}

function parseIssueRef(ref) {
  // URL form: https://github.com/owner/repo/issues/123
  const urlMatch = ref.match(/^https?:\/\/github\.com\/([^/]+\/[^/]+)\/issues\/(\d+)$/);
  if (urlMatch) {
    return { repo: urlMatch[1], number: parseInt(urlMatch[2], 10) };
  }

  // Shorthand form: owner/repo#123
  const shortMatch = ref.match(/^([^/]+\/[^#]+)#(\d+)$/);
  if (shortMatch) {
    return { repo: shortMatch[1], number: parseInt(shortMatch[2], 10) };
  }

  return null;
}

function findProjectByRepo(repo) {
  const projects = loadProjects();
  for (const [name, proj] of Object.entries(projects)) {
    if (proj.repo === repo) {
      return { project: proj, localPath: proj.localPath };
    }
    if (proj.packages) {
      for (const [pkgName, pkg] of Object.entries(proj.packages)) {
        if (pkg.repo === repo) {
          return { project: proj, localPath: path.join(proj.localPath, pkg.path), package: pkgName };
        }
      }
    }
  }
  return null;
}

function slugify(text) {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function buildPrompt(issueRef) {
  const parsed = parseIssueRef(issueRef);
  if (!parsed) {
    error(`Could not parse issue reference: ${issueRef}\n\nExpected:\n  https://github.com/owner/repo/issues/123\n  owner/repo#123`);
  }

  const flags = parseFlags(process.argv);
  const issueUrl = `https://github.com/${parsed.repo}/issues/${parsed.number}`;

  // Fetch issue data
  let issueJson;
  try {
    const raw = execSync(
      `gh issue view ${parsed.number} --repo ${parsed.repo} --json title,body,labels,number`,
      { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }
    );
    issueJson = JSON.parse(raw);
  } catch (err) {
    error(`Failed to fetch issue: gh issue view ${parsed.number} --repo ${parsed.repo}\n${err.stderr || err.message}`);
  }

  // Resolve base branch and local path from projects.json
  const match = findProjectByRepo(parsed.repo);
  const baseBranch = match ? match.project.featureTarget : 'main';
  const localPath = match ? match.localPath : null;

  // Derive branch name from SCOPE.json or issue title
  let shortDescription;
  if (flags.scope) {
    try {
      const scope = JSON.parse(fs.readFileSync(flags.scope, 'utf8'));
      shortDescription = scope.branch ? scope.branch.replace(/^feat\//, '') : slugify(issueJson.title);
    } catch {
      warn(`Could not read --scope file: ${flags.scope}, deriving branch from issue title`);
      shortDescription = slugify(issueJson.title);
    }
  } else {
    shortDescription = slugify(issueJson.title);
  }

  // Read template
  const templatePath = path.join(REPO_ROOT, 'templates', 'implement-issue.template.md');
  if (!fs.existsSync(templatePath)) {
    error(`Template not found: ${templatePath}`);
  }
  let template = fs.readFileSync(templatePath, 'utf8');

  // Replace placeholders
  template = template.replace(/\[ISSUE_URL\]/g, issueUrl);
  template = template.replace(/\[BASE_BRANCH\]/g, baseBranch);
  template = template.replace(/\[SHORT_DESCRIPTION\]/g, shortDescription);
  template = template.replace(/\[ISSUE_NUMBER\]/g, String(parsed.number));
  template = template.replace(/\[REPO\]/g, parsed.repo);
  template = template.replace(/\[REPO_NAME\]/g, parsed.repo.split('/')[1]);

  return { prompt: template, parsed, localPath, issueJson };
}

function promptGenerate(issueRef) {
  if (!issueRef) {
    error('Usage: auto-shop prompt <issue-ref> [--scope=<path>] [--clipboard]\n\n  <issue-ref> can be:\n    https://github.com/owner/repo/issues/123\n    owner/repo#123');
  }

  const { prompt } = buildPrompt(issueRef);

  process.stdout.write(prompt);

  if (process.argv.includes('--clipboard')) {
    try {
      execSync('pbcopy', { input: prompt, stdio: ['pipe', 'pipe', 'pipe'] });
      process.stderr.write('\n(Copied to clipboard)\n');
    } catch {
      process.stderr.write('\n(Failed to copy to clipboard — pbcopy not available)\n');
    }
  }
}

function launch(issueRef) {
  if (!issueRef) {
    error('Usage: auto-shop launch <issue-ref>\n\n  <issue-ref> can be:\n    https://github.com/owner/repo/issues/123\n    owner/repo#123');
  }

  const { prompt, parsed, localPath } = buildPrompt(issueRef);

  if (!localPath) {
    error(`Repo ${parsed.repo} not found in projects.json — cannot resolve local path`);
  }

  if (!fs.existsSync(localPath)) {
    error(`Local path does not exist: ${localPath}`);
  }

  info(`Issue:  ${parsed.repo}#${parsed.number}`);
  info(`Repo:   ${localPath}`);
  log('');

  // Write prompt to a temp file to avoid shell escaping issues with large prompts
  const tmpPrompt = path.join(require('os').tmpdir(), `auto-shop-prompt-${parsed.number}.md`);
  fs.writeFileSync(tmpPrompt, prompt);
  info(`Prompt: ${tmpPrompt}`);
  log('');

  try {
    execSync(`claude --remote "$(cat "${tmpPrompt}")"`, {
      cwd: localPath,
      stdio: 'inherit',
      shell: true,
    });
  } catch (err) {
    error(`Remote session failed: ${err.message}`);
  }
}

function schedulerStart() {
  const scheduler = require('../lib/scheduler/index');
  const running = scheduler.isRunning();
  if (running) {
    error(`Scheduler is already running (PID ${running}). Use 'auto-shop scheduler stop' first.`);
  }
  scheduler.start();
}

function schedulerStatus() {
  const scheduler = require('../lib/scheduler/index');
  const http = require('http');

  const running = scheduler.isRunning();
  if (running) {
    // Query the running daemon's API
    const req = http.get(`http://localhost:${scheduler.API_PORT}/api/scheduler/status`, (res) => {
      let data = '';
      res.on('data', chunk => { data += chunk; });
      res.on('end', () => {
        const state = JSON.parse(data);
        log(`\nScheduler Status: ${state.status}${state.paused ? ' (PAUSED)' : ''}`, 'blue');
        log(`  PID:          ${running}`);
        log(`  Started:      ${state.startedAt}`);
        log(`  Last scan:    ${state.lastScanAt || 'never'}`);
        log(`  API:          http://localhost:${scheduler.API_PORT}`);
        log('');

        log(`Active Sessions (${state.activeCount}/${state.maxSessions}):`, 'blue');
        if (state.activeSessions.length === 0) {
          log('  (none)');
        } else {
          for (const s of state.activeSessions) {
            log(`  ${s.issueRef}`, 'green');
            log(`    ${s.title}`);
            log(`    PID ${s.pid} | branch ${s.branch} | started ${s.startedAt}`);
          }
        }
        log('');

        log(`Queue (${state.queueSize}):`, 'blue');
        if (state.queue.length === 0) {
          log('  (empty)');
        } else {
          for (const q of state.queue) {
            log(`  ${q.issueRef} — ${q.title}`);
          }
        }
        log('');

        if (state.completed.length > 0) {
          log(`Recent Completions (last ${Math.min(state.completed.length, 10)}):`, 'blue');
          for (const c of state.completed.slice(-10)) {
            const exitLabel = c.exitCode === 0 ? 'OK' : `exit ${c.exitCode}`;
            log(`  ${c.issueRef} — ${exitLabel} — ${c.completedAt}`);
          }
          log('');
        }
      });
    });

    req.on('error', () => {
      warn(`Scheduler PID ${running} is running but API is not responding`);
      const saved = scheduler.readSavedState();
      if (saved) {
        log(`\nLast saved state:`, 'blue');
        log(JSON.stringify(saved, null, 2));
      }
    });
  } else {
    warn('Scheduler is not running');
    const saved = scheduler.readSavedState();
    if (saved) {
      log(`\nLast saved state:`, 'blue');
      log(`  Status:    ${saved.status}`);
      log(`  Started:   ${saved.startedAt}`);
      log(`  Last scan: ${saved.lastScanAt || 'never'}`);
      log(`  Queue:     ${saved.queue ? saved.queue.length : 0} items`);
      log(`  Completed: ${saved.completed ? saved.completed.length : 0} items`);
    }
    info('Start with: auto-shop scheduler start');
  }
}

function schedulerStop() {
  const scheduler = require('../lib/scheduler/index');
  const http = require('http');

  const running = scheduler.isRunning();
  if (!running) {
    warn('Scheduler is not running');
    return;
  }

  info(`Sending stop to scheduler (PID ${running})...`);
  const req = http.request(`http://localhost:${scheduler.API_PORT}/api/scheduler/stop`, { method: 'POST' }, (res) => {
    let data = '';
    res.on('data', chunk => { data += chunk; });
    res.on('end', () => {
      success('Scheduler stopping');
    });
  });

  req.on('error', () => {
    // API not responding, send SIGTERM directly
    try {
      process.kill(running, 'SIGTERM');
      success(`Sent SIGTERM to PID ${running}`);
    } catch {
      error(`Failed to stop scheduler PID ${running}`);
    }
  });

  req.end();
}

function showHelp() {
  log(`
auto-shop — Coordinator CLI for AI development cells

USAGE:
  auto-shop <command> [options]

COMMANDS:
  cell create <name> [--project=<p>] [--packages=<p1,p2,...>]
                          Create a new feature cell
                          - Branches from featureTarget (default: main)
                          - Uses project-specific scope template if available
                          - Provisions database schema (single-repo only)
                          --project:  Resolve path and settings from projects.json
                          --packages: For multi-repo projects, limit to specific
                                      packages (comma-separated). Default: all.

  cell list               List all cells across all registered projects
                          - Queries GitHub issues by cell: labels
                          - For multi-repo projects, queries each package repo
                          - Shows active, queued, blocked, awaiting-review

  cell teardown <name>    Clean up a feature cell
                          - Drops database schema
                          - Removes .env.local

  project list            List all registered projects
                          - Shows repo, path, branch flow, scope template
                          - Shows package count for multi-repo projects

  project show <name>     Show full details for a project
                          - Lists all packages with repos and paths
                          - Shows per-package overrides (featureTarget, scopeOverrides)

  queue show              Display the merge queue
                          - Shows cells ready to merge
                          - Shows merge order and dependencies

  queue next              Merge the next cell in queue
                          (Not yet implemented — use docs/merge-procedure.md)

  infra setup <project>   Set up Claude Code hooks and agent in a repo
                          - Resolves path from projects.json
                          - Creates .claude/hooks/ with scope enforcement
                          - Creates .claude/agents/ with cell-worker template
                          - Generates .claude/settings.json

  infra setup <path> <name>
                          Legacy two-arg form (still supported)

  prompt <issue-ref> [--scope=<path>] [--clipboard]
                          Generate an agent prompt for a GitHub issue
                          - <issue-ref> is a URL or owner/repo#N
                          - Fills in implement-issue.template.md placeholders
                          - Resolves base branch from projects.json
                          --scope:     Read SCOPE.json for branch name
                          --clipboard: Copy prompt to system clipboard

  launch <issue-ref>      Generate prompt and launch a remote session
                          - Resolves local path from projects.json
                          - Runs claude --remote from the correct directory
                          - Works from any directory

  scheduler start         Start the scheduler daemon
                          - Polls all repos for claude-ready issues every 5 min
                          - Maintains up to 4 concurrent claude --remote sessions
                          - Exposes API on port 3401 for GUI monitoring
                          - Labels: claude-ready -> cell:active -> cell:awaiting-review

  scheduler status        Show scheduler status
                          - Queries the running daemon or reads saved state

  scheduler stop          Stop the scheduler daemon gracefully

  help                    Show this help message

EXAMPLES:
  auto-shop project list
  auto-shop project show nodots-backgammon
  auto-shop cell create pr-calc --project=nodots-backgammon --packages=types,core
  auto-shop cell create full-feature --project=nodots-backgammon
  auto-shop cell create email-provider --project=a2z-freight-claims
  auto-shop cell list
  auto-shop cell teardown gnubg-hints
  auto-shop infra setup a2z-freight-claims
  auto-shop queue show
  auto-shop prompt nodots/ai-calc-tutor-mvp#1
  auto-shop prompt https://github.com/nodots/ai-calc-tutor-mvp/issues/1 --clipboard
  auto-shop launch nodots/PoslunsLaw#302

DOCUMENTATION:
  See docs/coordinator-workflow.md for detailed instructions
  See docs/quickstart.md for getting started

`, 'blue');
}

// Main
const command = process.argv[2];
const arg1 = process.argv[3];
const arg2 = process.argv[4];

switch (command) {
  case 'cell':
    if (arg1 === 'create') {
      cellCreate(arg2);
    } else if (arg1 === 'list') {
      cellList();
    } else if (arg1 === 'teardown') {
      cellTeardown(arg2);
    } else {
      error('Usage: auto-shop cell <create|list|teardown>');
    }
    break;

  case 'project':
    if (arg1 === 'list') {
      projectList();
    } else if (arg1 === 'show') {
      projectShow(arg2);
    } else {
      error('Usage: auto-shop project <list|show>');
    }
    break;

  case 'queue':
    if (arg1 === 'show') {
      queueShow();
    } else if (arg1 === 'next') {
      queueNext();
    } else {
      error('Usage: auto-shop queue <show|next>');
    }
    break;

  case 'infra':
    if (arg1 === 'setup') {
      infraSetup(arg2, process.argv[5]);
    } else {
      error('Usage: auto-shop infra <setup>');
    }
    break;

  case 'prompt':
    promptGenerate(arg1);
    break;

  case 'launch':
    launch(arg1);
    break;

  case 'scheduler':
    if (arg1 === 'start') {
      schedulerStart();
    } else if (arg1 === 'status') {
      schedulerStatus();
    } else if (arg1 === 'stop') {
      schedulerStop();
    } else {
      error('Usage: auto-shop scheduler <start|status|stop>');
    }
    break;

  case 'help':
  case '--help':
  case '-h':
    showHelp();
    break;

  default:
    showHelp();
}
