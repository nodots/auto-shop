{
  "name": "auto-shop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set -a && . ../.env && set +a && ../scripts/run-on-port.sh 3400 tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "drizzle-orm": "^0.38.0",
    "@octokit/rest": "^21.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0"
  }
}
